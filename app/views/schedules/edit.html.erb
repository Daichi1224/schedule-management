<div class="row justify-content-center mt-5">
  <div class="col-md-8 col-lg-6">
    <h4 class="mb-4">予定を編集してください</h4>

    <div class="card shadow-sm p-4">
      <%= form_with(model: @schedule, local: true) do |f| %>
        
        <% if @schedule.errors.any? %>
          <div class="alert alert-danger">
            <ul class="mb-0">
              <% @schedule.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div class="mb-3">
          <%= f.label :title, "タイトル", class: "form-label fw-bold" %>
          <span class="text-danger small">*</span>
          <%= f.text_field :title, class: "form-control" %>
        </div>

        <div class="row mb-3">
          <div class="col-6">
            <%= f.label :start_date, "開始日", class: "form-label fw-bold" %>
            <span class="text-danger small">*</span>
            <%= f.date_field :start_date, class: "form-control" %>
          </div>
          <div class="col-6">
            <%= f.label :end_date, "終了日", class: "form-label fw-bold" %>
            <span class="text-danger small">*</span>
            <%= f.date_field :end_date, class: "form-control" %>
          </div>
        </div>

        <div class="mb-3 form-check">
          <%= f.check_box :is_all_day, class: "form-check-input" %>
          <%= f.label :is_all_day, "終日の場合はチェックを入れます", class: "form-check-label" %>
        </div>

        <div class="mb-4">
          <%= f.label :comment, "スケジュールメモ", class: "form-label fw-bold" %>
          <%= f.text_area :comment, class: "form-control", rows: 4 %>
        </div>

        <div class="d-flex justify-content-end gap-2">
          <%= link_to "キャンセル", schedule_path(@schedule), class: "btn btn-outline-secondary px-4" %>
          <%= f.submit "保存する", 
              class: "btn rounded-pill px-4", 
              style: "background-color: #d1e7dd; color: #0f5132; border: 1px solid #badbcc;" %>
        </div>
      <% end %>
    </div>
  </div>
</div>