<div class="row justify-content-center mt-5">
  <div class="col-md-8 col-lg-7">
    
    <nav class="mb-3">
      <%= link_to "← 一覧に戻る", schedules_path, class: "text-decoration-none text-secondary" %>
    </nav>

    <div class="d-flex justify-content-between align-items-center mb-4">
      <h2 class="mb-0"><%= @schedule.title %></h2>
      <%= link_to edit_schedule_path(@schedule), 
          class: "btn rounded-pill px-4 d-flex align-items-center gap-2", 
          style: "background-color: #d1e7dd; color: #0f5132; border: 1px solid #badbcc;" do %>
        <i class="bi bi-pencil"></i> 編集
      <% end %>
    </div>

    <div class="card shadow-sm overflow-hidden">
      <table class="table mb-0">
        <tbody>
          <tr>
            <th class="bg-light w-25 py-3 ps-4 text-secondary">開始日</th>
            <td class="py-3 ps-4"><%= @schedule.start_date.strftime("%Y/%m/%d") %></td>
          </tr>
          <tr>
            <th class="bg-light py-3 ps-4 text-secondary">終了日</th>
            <td class="py-3 ps-4"><%= @schedule.end_date.strftime("%Y/%m/%d") %></td>
          </tr>
          <tr>
            <th class="bg-light py-3 ps-4 text-secondary">終日</th>
            <td class="py-3 ps-4"><%= @schedule.is_all_day ? "○" : "" %></td>
          </tr>
          <tr>
            <th class="bg-light py-3 ps-4 text-secondary">スケジュールメモ</th>
            <td class="py-3 ps-4">
              <div class="text-break" style="min-height: 100px;">
                <%= simple_format(@schedule.comment) %>
              </div>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</div>